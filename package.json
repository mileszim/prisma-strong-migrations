{
  "name": "prisma-strong-migrations",
  "version": "1.0.0",
  "description": "Lint Prisma migrations for unsafe SQL before it reaches production",
  "keywords": [
    "prisma",
    "migrations",
    "sql",
    "linter",
    "postgresql",
    "database",
    "safety",
    "ci-cd",
    "github-action"
  ],
  "author": "Miles Zimmerman <miles@zim.dev> (https://zim.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mileszim/prisma-strong-migrations.git"
  },
  "bugs": {
    "url": "https://github.com/mileszim/prisma-strong-migrations/issues"
  },
  "homepage": "https://github.com/mileszim/prisma-strong-migrations#readme",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "prisma-strong-migrations": "dist/cli.js",
    "psm": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "glob": "^11.0.0",
    "picocolors": "^1.1.1",
    "sql-parser-cst": "^0.42.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^2.1.8"
  }
}
